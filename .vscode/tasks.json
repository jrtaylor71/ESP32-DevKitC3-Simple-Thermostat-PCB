{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Build & Organize Firmware",
      "type": "shell",
      "command": "cd ${workspaceFolder} && ./build.sh all",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$platformio"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "PlatformIO: Clean & Build & Organize",
      "type": "shell",
      "command": "cd ${workspaceFolder} && ./build.sh clean all",
      "group": {
        "kind": "build"
      },
      "problemMatcher": [
        "$platformio"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Organize Firmware Only",
      "type": "shell",
      "command": "cd ${workspaceFolder} && ./organize_firmware.sh",
      "group": {
        "kind": "none"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Update Handoff File",
      "type": "shell",
      "command": "cd ${workspaceFolder} && sed -i 's/^Last Updated: .*/Last Updated: '$(date +%Y-%m-%d)'/' SESSION_HANDOFF.txt && echo 'Handoff updated.'",
      "group": {
        "kind": "none"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
