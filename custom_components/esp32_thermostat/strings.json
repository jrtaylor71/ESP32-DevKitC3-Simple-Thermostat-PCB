{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Connect to ESP32 thermostat",
        "description": "Enable the Home Assistant API on the thermostat first, then enter its address and API token.",
        "data": {
          "host": "Host",
          "token": "API token"
        },
        "data_description": {
          "host": "Hostname or IP address of the thermostat.",
          "token": "API token shown on the thermostat under System Info > HA API, or in the web UI Settings tab."
        }
      },
      "zeroconf_confirm": {
        "title": "Discovered ESP32 thermostat",
        "description": "Set up {name} ({host})? Enter the API token shown on the thermostat.",
        "data": {
          "token": "API token"
        },
        "data_description": {
          "token": "API token shown on the thermostat under System Info > HA API, or in the web UI Settings tab."
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate {name}",
        "description": "The API token for {name} was rejected. Enter the current token shown on the thermostat.",
        "data": {
          "token": "API token"
        },
        "data_description": {
          "token": "API token shown on the thermostat under System Info > HA API, or in the web UI Settings tab."
        }
      },
      "reconfigure": {
        "title": "Reconfigure {name}",
        "description": "Change the address of the thermostat.",
        "data": {
          "host": "Host"
        },
        "data_description": {
          "host": "Hostname or IP address of the thermostat."
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid API token.",
      "api_disabled": "The Home Assistant API is disabled on the thermostat. Enable it in the thermostat settings.",
      "cannot_connect": "Failed to connect to the thermostat.",
      "unknown": "Unexpected error."
    },
    "abort": {
      "already_configured": "This thermostat is already configured.",
      "reauth_successful": "Re-authentication was successful.",
      "reconfigure_successful": "Reconfiguration was successful.",
      "wrong_device": "The address belongs to a different thermostat.",
      "not_ipv4_address": "Only IPv4 addresses are supported.",
      "invalid_discovery_info": "The discovered device did not provide a device id.",
      "unsupported_api_version": "The discovered thermostat uses an unsupported API version."
    }
  },
