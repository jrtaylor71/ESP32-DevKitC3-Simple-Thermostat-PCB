      }
    }
  },
  "services": {
    "set_schedule": {
      "name": "Set schedule",
      "description": "Partially updates the thermostat's weekly schedule.",
      "fields": {
        "device_id": {
          "name": "Thermostat",
          "description": "The thermostat to update."
        },
        "schedule_enabled": {
          "name": "Schedule enabled",
          "description": "Enable or disable the schedule."
        },
        "days": {
          "name": "Days",
          "description": "List of day entries identified by `day` (sunday..saturday) or `index` (0 = Sunday) with any of `enabled`, `day_period`, `night_period` (periods: `hour`, `minute`, `heat`, `cool`, `auto`, `active`). The `days` list returned by Get schedule can be passed directly."
        }
      }
    },
    "get_schedule": {
      "name": "Get schedule",
      "description": "Returns the thermostat's full weekly schedule.",
      "fields": {
        "device_id": {
          "name": "Thermostat",
          "description": "The thermostat to read."
        }
      }
    },
    "set_override": {
      "name": "Set schedule override",
      "description": "Resumes the schedule or places a temporary or permanent hold.",
      "fields": {
        "device_id": {
          "name": "Thermostat",
          "description": "The thermostat to control."
        },
        "mode": {
          "name": "Mode",
          "description": "Override mode."
        }
      }
    }
  }
